{
  "manifest_version": 3,
  "name": "GrabIt",
  "version": "4.0.0",
  "description": "Download YouTube, Instagram, and any media  — fast.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "tabs",
    "webRequest",
    "scripting",
    "cookies",
    "downloads",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "scripts/background/sw.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "scripts/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content/detectors/generic.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/facebook.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/facebook_untrusted.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/vimeo.js"
      ],
      "matches": [
        "*://*.vimeo.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/vimeo_untrusted.js"
      ],
      "matches": [
        "*://*.vimeo.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/ok.js"
      ],
      "matches": [
        "*://*.ok.ru/*",
        "*://*.m.ok.ru/*"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/vk.js"
      ],
      "matches": [
        "*://*.vk.com/*",
        "*://*.vk.ru/*",
        "*://*.vkvideo.ru/*",
        "*://live.vkvideo.ru/*"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/chaturbate.js"
      ],
      "matches": [
        "*://*.chaturbate.com/*",
        "*://*.chaturbate.eu/*",
        "*://*.chaturbate.global/*"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}