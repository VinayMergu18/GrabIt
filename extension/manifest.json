{
  "manifest_version": 3,
  "name": "GrabIt",
  "version": "4.0.0",
  "description": "Download YouTube, Instagram, and any media \u00e2\u20ac\u201d fast.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "tabs",
    "webRequest",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:7272/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "scripts/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "scripts/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content/detectors/generic.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/youtube_vdown.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/youtube_vdown_untrusted.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/facebook.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/facebook_untrusted.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/vimeo.js"
      ],
      "matches": [
        "*://*.vimeo.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "all_frames": true,
      "js": [
        "scripts/content/detectors/vimeo_untrusted.js"
      ],
      "matches": [
        "*://*.vimeo.com/*"
